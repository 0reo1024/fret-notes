{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Fret Notes",
  "version": "1.1.0",
  "identifier": "jp.fretnotes.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Fret Notes", "width": 1280, "height": 850, "minWidth": 700, "minHeight": 550, "backgroundColor": "#202020" }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "capabilities": ["main"]
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
